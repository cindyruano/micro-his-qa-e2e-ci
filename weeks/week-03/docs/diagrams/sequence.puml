@startuml
actor "Runner CI" as ci
participant "Presentation" as p
participant "RunQualityGate" as app
participant "E2ERunner" as e2e
participant "Domain" as domain
database "PDO" as db
ci -> p: commit, environment, plan
p -> app: execute(...)
app -> e2e: run(plan)
e2e --> app: control results
app -> domain: create QualityGateRun
app -> db: prepared INSERT in transaction
db --> app: persisted run/results
app -> db: prepared INSERT evidence
app --> p: passed or failed
p --> ci: exit 0 or 1
@enduml
