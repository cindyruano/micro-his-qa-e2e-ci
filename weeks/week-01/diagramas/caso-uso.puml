@startuml caso-uso
left to right direction
skinparam packageStyle rectangle

title Casos de uso críticos - Sistema Hospitalario Integrado

actor "Usuario operativo" as user
actor "Recepcionista" as receptionist
actor "Médico" as doctor
actor "Enfermera" as nurse
actor "Técnico de laboratorio" as lab
actor "Administrador" as admin
actor "Runner CI/CD" as ci

rectangle "Sistema Laravel HIS" {
    usecase "CU-01\nAutenticar usuario\ny gestionar sesión" as UC01
    usecase "CU-02\nRegistrar paciente\ny admisión" as UC02
    usecase "CU-03\nConsultar y actualizar\nexpediente clínico" as UC03
    usecase "CU-04\nGestionar orden y\nresultado de laboratorio" as UC04
    usecase "CU-05\nAutorizar acceso por\nrol y tenant" as UC05
    usecase "Verificar tenant\nX-Tenant-ID" as Tenant
    usecase "Validar rol y permiso" as Permission
}

user --> UC01
user --> Tenant
receptionist --|> user
doctor --|> user
nurse --|> user
lab --|> user

receptionist --> UC02
doctor --> UC03
nurse --> UC03
lab --> UC04
doctor --> UC04 : Ordena / valida
admin --> UC01
admin --> UC05
ci --> UC01 : Prueba
ci --> UC02 : Suite futura
ci --> UC03 : Suite futura
ci --> UC04 : Suite futura
ci --> UC05 : Suite futura

UC01 ..> Tenant : <<include>>
UC02 ..> Tenant : <<include>>
UC03 ..> Tenant : <<include>>
UC04 ..> Tenant : <<include>>
UC05 ..> Tenant : <<include>>
UC02 ..> Permission : <<include>>
UC03 ..> Permission : <<include>>
UC04 ..> Permission : <<include>>
UC05 ..> Permission : <<include>>
@enduml
