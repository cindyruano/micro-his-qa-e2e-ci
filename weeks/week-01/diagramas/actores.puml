@startuml actores
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title Actores del Sistema Hospitalario Integrado (HIS)

actor "Usuario operativo\n(Recepcionista / Médico / Enfermera / Técnico Lab)" as operativo #C6F6D5
actor "Administrador\ndel sistema" as admin #FED7D7
actor "Runner CI/CD\n(PHPUnit / E2E)" as ci #E9D8FD
actor "Servicio de\nnotificaciones" as notifications #E6FFFA

rectangle "Sistema Laravel HIS\nAPI + Web" as his #F8FAFC {
	rectangle "TenantMiddleware\nX-Tenant-ID" as tenant
	rectangle "AuthController\nJWT / guard api" as auth
	rectangle "Módulos clínicos\nPacientes, Admisiones, EMR, Laboratorio" as clinical
}

operativo --> tenant : Selecciona tenant
operativo --> auth : Registro / login / sesión
operativo --> clinical : Opera según rol
admin --> tenant : Administra su tenant
admin --> auth : Gestiona usuarios y roles
admin --> clinical : Consulta según permisos
ci --> his : Ejecuta pruebas y migraciones
clinical ..> notifications : Alertas críticas / eventos

note right of auth
Rutas actuales:
POST /api/auth/register
POST /api/auth/login
GET  /api/auth/me
POST /api/auth/refresh
POST /api/auth/logout
end note
@enduml
