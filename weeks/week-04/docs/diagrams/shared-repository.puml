@startuml
actor "CI / Reportes" as ci
package "Micro-HIS QA" {
  [QualityGateController] as controller
  [RunQualityGate] as app
  interface "QualityGateRepository" as port
  [PDO Adapter] as adapter
}
database "Repositorio de datos compartido\nPostgreSQL / esquema qa" as shared
package "Otros módulos HIS" {
  [Clinical adapters\nread-only or own ports] as clinical
}
ci --> controller
controller --> app
app --> port
adapter ..|> port
adapter --> shared
clinical --> shared : read projection
shared ..> clinical : no direct domain coupling
@enduml
